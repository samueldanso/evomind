# EvoResearch — local environment variables
# Copy this to .env and fill in your keys. .env is gitignored — never commit it.

# Required for embed.py and query embedding in chat_server.py
OPENAI_API_KEY=sk-...

# Required for answer generation in chat_server.py
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override embedding/chat model providers (default: openai for embed, anthropic for chat)
# EVO_LLM_PROVIDER=anthropic

# Optional — swap to OpenRouter or a local proxy without changing code
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional — FastAPI chat server port (default: 8765)
# EVO_CHAT_PORT=8765

# Optional — override vault path (default: ~/Library/Mobile Documents/iCloud~md~obsidian/...)
# EVO_RESEARCH_STORE=/path/to/your/vault/Knowledge/Research
