# EvoResearch — local environment variables
# AWS credentials are used for all inference (Bedrock).
# Standard AWS credential resolution applies — set these or use ~/.aws/credentials.

# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Optional — chat server port (default: 8765)
# EVO_CHAT_PORT=8765

# Optional — vault path override
# EVO_RESEARCH_STORE=/path/to/your/vault/Knowledge/Research
